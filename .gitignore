# ── Large binary EEG files (always ignore) ──
*.fif
*.npy
*.npz
*.eeg
*.vhdr
*.vmrk
*.tsv

# ── Virtual environment ──
eeg-env/

# ── IDE and system files ──
.DS_Store
.vscode/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── Dataset outputs ──
# Ignore everything inside outputs by default
Dataset/outputs/*

# Allow the directory structure to be traversed
!Dataset/outputs/*/
!Dataset/outputs/group_level/

# Allow root-level outputs (PNGs + JSONs used by the notebook)
!Dataset/outputs/*.json
!Dataset/outputs/*.png

# Allow group_level outputs (PNGs + JSONs)
!Dataset/outputs/group_level/*.json
!Dataset/outputs/group_level/*.png

# Allow sub-01 outputs only (example subject used in notebook)
!Dataset/outputs/sub-01/
!Dataset/outputs/sub-01/*.json
!Dataset/outputs/sub-01/*.png

# For sub-02 through sub-31: JSON summaries only (tiny files for subject count check)
!Dataset/outputs/sub-*/*.json

# Block PNGs from all subjects except sub-01
Dataset/outputs/sub-02/*.png
Dataset/outputs/sub-03/*.png
Dataset/outputs/sub-04/*.png
Dataset/outputs/sub-05/*.png
Dataset/outputs/sub-06/*.png
Dataset/outputs/sub-07/*.png
Dataset/outputs/sub-08/*.png
Dataset/outputs/sub-09/*.png
Dataset/outputs/sub-10/*.png
Dataset/outputs/sub-11/*.png
