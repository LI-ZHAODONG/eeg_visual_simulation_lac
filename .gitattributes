# Default: normalize line endings to LF in the repo
* text=auto

# Shell scripts must always use LF (bash breaks on CRLF)
*.sh text eol=lf

# Batch files must use CRLF on Windows
*.bat text eol=crlf

# Python files use LF
*.py text eol=lf

# JSON and text files use LF
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary files - no line ending conversion
*.pdf binary
*.fif binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
